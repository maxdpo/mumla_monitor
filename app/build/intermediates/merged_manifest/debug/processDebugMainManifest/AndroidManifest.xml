<?xml version="1.0" encoding="utf-8"?>
<!-- IW2DPO - MumlaMonitor: controlla ogni 60 s che Mumla sia viva, altrimenti la riapre -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="it.iw2dpo.mumlamonitor"
    android:versionCode="3"
    android:versionName="1.2-IW2DPO" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="33" />

    <!-- Servizio sempre attivo con notifica fissa -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Ripartenza automatica all'accensione della radio -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Mostra sopra altre app": eccezione che permette di aprire Mumla dal background (Android 10+) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Richiesta di esclusione dall'ottimizzazione batteria -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+: rende visibile il pacchetto di Mumla a questa app -->
    <queries>
        <package android:name="se.lublin.mumla" />
        <package android:name="se.lublin.mumla.beta" />
        <package android:name="se.lublin.mumla.donation" />
    </queries>

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@android:drawable/ic_popup_sync"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar" >
        <activity
            android:name="it.iw2dpo.mumlamonitor.MainActivity"
            android:exported="true"
            android:launchMode="singleTop" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="it.iw2dpo.mumlamonitor.WatchdogService"
            android:exported="false" />

        <receiver
            android:name="it.iw2dpo.mumlamonitor.BootReceiver"
            android:exported="true" >

            <!--
                 22-11-2026-3: priorita' alta. Il segnale di avvio viene consegnato alle app
                 una alla volta: senza priorita' MumlaMonitor era l'ultimo di 43 (~1 minuto).
            -->
            <intent-filter android:priority="999" >
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>